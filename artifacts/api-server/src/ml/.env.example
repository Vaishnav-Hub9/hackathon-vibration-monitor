# ML server (FastAPI + XGBoost) environment — AI Technician Summaries
# Copy to `.env` in THIS directory (artifacts/api-server/src/ml) or export in the shell.
# server.py reads these via os.getenv — no secrets are committed to the repo.

# Azure OpenAI (preferred when all three are set):
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
AZURE_OPENAI_API_VERSION=2024-06-01

# Plain OpenAI fallback (used only if the Azure vars above are NOT set):
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-3.5-turbo

# If neither provider is configured, /predict falls back to a realistic mock
# technician summary so the demo works with zero setup.
