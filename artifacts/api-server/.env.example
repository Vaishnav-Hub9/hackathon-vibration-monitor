PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartbearing
JWT_SECRET=smartbearing_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
SIMULATOR_AUTO_START=true

