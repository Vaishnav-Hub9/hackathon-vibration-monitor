[TEMPLATE]
PORT=5000
MONGODB_URI=mongodb://localhost:27017/smartbearing
JWT_SECRET=smartbearing_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
SIMULATOR_AUTO_START=true

# ---- AI Technician Summaries (ML server) ----
# Azure OpenAI (preferred when all three are set):
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
#AZURE_OPENAI_DEPLOYMENT=gpt-35-turbo
#AZURE_OPENAI_API_VERSION=2024-06-01
# Plain OpenAI fallback (used only if the Azure vars above are not set):
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-3.5-turbo
# If neither is set, summaries fall back to a realistic mock string (demo mode).

# ---- Email Alert Delivery (SMTP) ----
# When configured, every new WARNING/CRITICAL alert is emailed to the
# addresses users registered with, plus MAIL_RECIPIENT when set.
# Defaults target Gmail; any SMTP server works (SMTP_HOST / SMTP_PORT).
# For Gmail use an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords) — not the regular login password.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=you@gmail.com
#SMTP_PASS=your-16-char-app-password
#MAIL_FROM=you@gmail.com
# Recipient always notified in addition to registered users' emails:
#MAIL_RECIPIENT=you@gmail.com
